# Production — скопировать на сервер как .env и заполнить секреты
# cp .env.production.example .env

# PostgreSQL (Postilka app)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postilka
POSTGRES_USER=postilka
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES
DATABASE_URL=postgres://postilka:CHANGE_ME_STRONG_POSTGRES@postgres:5432/postilka?sslmode=disable

# MySQL (WordPress)
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=CHANGE_ME_STRONG_WP
WP_DB_ROOT_PASSWORD=CHANGE_ME_STRONG_WP_ROOT

# Backend
SERVER_PORT=8080
JWT_SECRET=CHANGE_ME_JWT_MIN_32_CHARS_RANDOM
API_KEY_SALT=CHANGE_ME_API_KEY_SALT_RANDOM
ENVIRONMENT=production
LOG_LEVEL=info
PUBLIC_APP_URL=https://postilka.ru/app
DOMAIN=postilka.ru

# Platform superadmin — after deploy:
# docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml exec -T backend \
#   /app/create-superadmin -email you@example.com -password 'Secret1!' -name Admin

# Yandex GPT / KIE — optional until wave 7
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_BASE_URL=https://ai.api.cloud.yandex.net/v1
KIE_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=/app/api/v1
NEXT_PUBLIC_APP_NAME=Postilka
NEXT_PUBLIC_SITE_URL=https://postilka.ru
# NEXT_PUBLIC_PRIVACY_POLICY_URL=https://postilka.ru/privacy-policy
INTERNAL_API_URL=http://backend:8080

# Workers
WORKER_PUBLISH_CONCURRENCY=3

# Billing (wave 6)
# YOOKASSA_SHOP_ID=
