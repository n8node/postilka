# PostgreSQL (Postilka app)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postilka
POSTGRES_USER=postilka
POSTGRES_PASSWORD=change_me_postgres
DATABASE_URL=postgres://postilka:change_me_postgres@postgres:5432/postilka?sslmode=disable

# MySQL (WordPress)
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=change_me_wp
WP_DB_ROOT_PASSWORD=change_me_wp_root

# Backend
SERVER_PORT=8080
JWT_SECRET=change_me_jwt_secret_min_32_characters
API_KEY_SALT=change_me_api_key_salt
ENVIRONMENT=development
LOG_LEVEL=info
PUBLIC_APP_URL=http://localhost/app
DOMAIN=localhost

# Yandex GPT (optional bootstrap)
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_BASE_URL=https://ai.api.cloud.yandex.net/v1

# KIE.ai (optional bootstrap)
KIE_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=/app/api/v1
NEXT_PUBLIC_APP_NAME=Postilka
NEXT_PUBLIC_SITE_URL=http://localhost
# NEXT_PUBLIC_PRIVACY_POLICY_URL=http://localhost/privacy-policy
INTERNAL_API_URL=http://backend:8080

# Workers (future)
WORKER_PUBLISH_CONCURRENCY=3

# Production (uncomment in prod overlay)
# NATS_URL=nats://nats:4222
# DRAGONFLY_URL=redis://dragonfly:6379
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=postilka-media
